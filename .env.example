APP_NAME=Video Surveillance Backend
APP_ENV=development
DEBUG=true

POSTGRES_DB=surveillance_db
POSTGRES_USER=surveillance
POSTGRES_PASSWORD=dev_password_change_me

DATABASE_URL=postgresql+asyncpg://surveillance:dev_password_change_me@localhost:5432/surveillance_db

JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOW_PUBLIC_REGISTRATION=true
